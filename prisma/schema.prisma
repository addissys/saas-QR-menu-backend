generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS functions
// ==========================================

enum TenantStatus {
  PENDING
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum NotificationType {
  SYSTEM
  SUBSCRIPTION
  BRANCH
  MENU
  PROMOTION
  ALERT
}

// ==========================================
// 1. AUTHENTICATION & AUTHORIZATION MODULE
// ==========================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  role_id           String    @db.Uuid
  full_name         String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  phone             String?   @unique @db.VarChar(20)
  password          String    @db.VarChar(255)
  profile_image     String?   @db.VarChar(500)
  email_verified_at DateTime? @db.Timestamp()

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamp()
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at DateTime? @db.Timestamp()

  // Relations
  role                  Role                 @relation(fields: [role_id], references: [id])
  user_sessions         UserSession[]
  owned_tenants         Tenant[]             @relation("TenantOwner")
  staff_profile         Staff[]
  password_reset_tokens PasswordResetToken[]
  generated_qrs         QrCode[]             @relation("QrGenerator")
  notifications         Notification[]
  audit_logs            AuditLog[]

  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(255)
  description String?   @db.Text
  created_at  DateTime  @default(now()) @db.Timestamp()
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at  DateTime? @db.Timestamp()

  // Relations
  users       User[]
  permissions RolePermission[]
  staff       Staff[]

  @@map("roles")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  access_token  String    @db.Text
  refresh_token String    @db.Text
  ip_address    String?   @db.VarChar(255)
  user_agent    String?   @db.Text
  device_name   String?   @db.VarChar(255)
  expires_at    DateTime  @default(now()) @db.Timestamp()
  revoked_at    DateTime? @db.Timestamp()
  created_at    DateTime  @default(now()) @db.Timestamp()

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.Text
  expires_at DateTime  @db.Timestamp()
  used_at    DateTime? @db.Timestamp()
  created_at DateTime  @default(now()) @db.Timestamp()

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  permission  String    @db.VarChar(255)
  module      String    @db.VarChar(255)
  action      String    @db.VarChar(255)
  description String?   @db.Text
  created_at  DateTime  @default(now()) @db.Timestamp()
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at  DateTime? @db.Timestamp()

  // Relations
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String    @db.Uuid
  permission_id String    @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamp()
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at    DateTime? @db.Timestamp()

  // Relations
  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

// ==========================================
// 2. SAAS MANAGEMENT MODULE
// ==========================================

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  owner_id      String       @db.Uuid
  business_name String       @db.VarChar(255)
  business_slug String       @unique @db.VarChar(100)
  logo_url      String?      @db.VarChar(500)
  brand_color   String?      @db.VarChar(30)
  email         String       @unique @db.VarChar(255)
  phone         String?      @unique @db.VarChar(20)
  address       String       @db.VarChar(255)
  city          String       @db.VarChar(100)
  country       String       @db.VarChar(100)
  status        TenantStatus @default(PENDING)
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamp()
  updated_at    DateTime     @default(now()) @updatedAt @db.Timestamp()
  deleted_at    DateTime?    @db.Timestamp()

  // Relations
  owner      User       @relation("TenantOwner", fields: [owner_id], references: [id])
  branches   Branch[]
  audit_logs AuditLog[]

  @@map("tenants")
}

// ==========================================
// 3. BRANCH MANAGEMENT MODULE
// ==========================================

model Branch {
  id          String       @id @default(uuid()) @db.Uuid
  tenant_id   String       @db.Uuid
  manager_id  String?      @db.Uuid
  branch_name String       @db.VarChar(255)
  branch_code String       @unique @db.VarChar(100)
  address     String       @db.VarChar(255)
  city        String       @db.VarChar(100)
  phone       String?      @db.VarChar(20)
  status      BranchStatus @default(ACTIVE)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamp()
  updated_at  DateTime     @default(now()) @updatedAt @db.Timestamp()
  deleted_at  DateTime?    @db.Timestamp()

  // Relations
  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  manager    Staff?     @relation("BranchManager", fields: [manager_id], references: [id])
  staff      Staff[]    @relation("BranchStaff")
  executives ExecutiveBranch[] @relation("BranchExecutives")
  tables     Table[]
  categories Category[]
  menu_items MenuItem[]

  @@map("branches")
}

model Staff {
  id                String           @id @default(uuid()) @db.Uuid
  user_id           String           @db.Uuid
  role_id           String           @db.Uuid
  branch_id         String?          @db.Uuid
  hire_date         DateTime         @db.Date
  employment_status EmploymentStatus @default(ACTIVE)
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now()) @db.Timestamp()
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamp()
  deleted_at        DateTime?        @db.Timestamp()

  // Relations
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [role_id], references: [id])
  branch           Branch?  @relation("BranchStaff", fields: [branch_id], references: [id])
  managed_branches Branch[] @relation("BranchManager")
  executive_branches ExecutiveBranch[] @relation("ExecutiveBranches")

  @@map("staff")
}

model Table {
  id           String    @id @default(uuid()) @db.Uuid
  branch_id    String    @db.Uuid
  table_number String    @db.VarChar(50)
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamp()
  deleted_at   DateTime? @db.Timestamp()

  // Relations
  branch  Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  qr_code QrCode?

  @@map("tables")
}

model QrCode {
  id           String    @id @default(uuid()) @db.Uuid
  table_id     String    @unique @db.Uuid
  generated_by String    @db.Uuid
  qr_image_url String    @db.Text
  qr_token     String    @unique @db.VarChar(255)
  public_url   String    @db.VarChar(500)
  expires_at   DateTime? @db.Timestamp()
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamp()
  deleted_at   DateTime? @db.Timestamp()

  // Relations
  table     Table @relation(fields: [table_id], references: [id], onDelete: Cascade)
  generator User  @relation("QrGenerator", fields: [generated_by], references: [id])

  @@map("qr_codes")
}

// ==========================================
// 4. MENU MANAGEMENT MODULE
// ==========================================

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  branch_id   String    @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(200)
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp()
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at  DateTime? @db.Timestamp()

  // Relations
  branch     Branch     @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  menu_items MenuItem[]

  @@map("categories")
}

model MenuItem {
  id               String    @id @default(uuid()) @db.Uuid
  branch_id        String    @db.Uuid
  category_id      String    @db.Uuid
  name             String    @db.VarChar(255)
  description      String?   @db.Text
  price            Decimal   @db.Decimal(10, 2)
  image_url        String?   @db.Text
  preparation_time Int?
  is_available     Boolean   @default(true)
  is_featured      Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamp()
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at       DateTime? @db.Timestamp()

  // Relations
  branch   Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@map("menu_items")
}

// ==========================================
// 5. SYSTEM MODULE
// ==========================================

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  user_id    String           @db.Uuid
  title      String           @db.VarChar(255)
  message    String           @db.Text
  type       NotificationType @default(SYSTEM)
  is_read    Boolean          @default(false)
  sent_at    DateTime         @default(now()) @db.Timestamp()
  read_at    DateTime?        @db.Timestamp()
  deleted_at DateTime?        @db.Timestamp()

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  tenant_id   String?  @db.Uuid
  module      String   @db.VarChar(255)
  action      String   @db.VarChar(255)
  entity_name String?  @db.VarChar(255)
  entity_id   String?  @db.Uuid
  old_values  Json?    @db.JsonB
  new_values  Json?    @db.JsonB
  ip_address  String?  @db.VarChar(255)
  user_agent  String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp()

  // Relations
  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ExecutiveBranch {
  id           String   @id @default(uuid()) @db.Uuid
  executive_id String   @db.Uuid
  branch_id    String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamp()
  deleted_at   DateTime? @db.Timestamp()

  executive Staff  @relation("ExecutiveBranches", fields: [executive_id], references: [id], onDelete: Cascade)
  branch    Branch @relation("BranchExecutives", fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([executive_id, branch_id])
  @@map("executive_branches")
}